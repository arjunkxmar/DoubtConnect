// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String         @id @default(cuid())
  fullName     String
  email        String         @unique
  password     String
  college      String
  branch       String
  academicYear String
  subjects     String         // Storing as comma-separated string for SQLite simplicity
  skills       String         // Storing as comma-separated string for SQLite simplicity
  points       Int            @default(0) // Contribution points
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  doubts       Doubt[]
  answers      Answer[]
  votes        Vote[]
  notifications Notification[]
  conversations Conversation[]
  messagesSent Message[]
  posts        Post[]
  postLikes    PostLike[]
  postSaves    PostSave[]
  postComments PostComment[]
  postReports  PostReport[]
}

model Doubt {
  id               String   @id @default(cuid())
  title            String
  description      String
  subject          String
  topic            String
  targetYear       String
  attachmentUrl    String?
  tags             String
  isResolved       Boolean  @default(false)
  authorId         String
  author           User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answers          Answer[]
  votes            Vote[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Answer {
  id          String   @id @default(cuid())
  content     String
  isBest      Boolean  @default(false)
  authorId    String
  doubtId     String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  doubt       Doubt    @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  votes       Vote[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vote {
  id        String   @id @default(cuid())
  value     Int      // 1 for upvote, -1 for downvote
  userId    String
  doubtId   String?
  answerId  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doubt     Doubt?   @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  answer    Answer?  @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([userId, doubtId])
  @@unique([userId, answerId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // e.g. "MATCH", "BEST_ANSWER"
  message   String
  isRead    Boolean  @default(false)
  linkUrl   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Conversation {
  id           String    @id @default(cuid())
  participants User[]    // Implicit many-to-many relation
  messages     Message[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  content        String
  isRead         Boolean      @default(false)
  
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime     @default(now())
}

// ─── Community ─────────────────────────────────────────────────────────────

model Post {
  id          String        @id @default(cuid())
  // type: "skill" | "notes" | "learning_tip" | "event" | "opportunity" | "discussion" | "achievement" | "announcement" | "resource"
  type        String        @default("discussion")
  title       String?                               // optional short title
  content     String
  tags        String        @default("")   // comma-separated
  subject     String?
  college     String?
  branch      String?
  imageUrl    String?
  
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  likes       PostLike[]
  saves       PostSave[]
  comments    PostComment[]
  reports     PostReport[]
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model PostLike {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@unique([userId, postId])
}

model PostSave {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@unique([userId, postId])
}

model PostComment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model PostReport {
  id        String   @id @default(cuid())
  reason    String
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}
